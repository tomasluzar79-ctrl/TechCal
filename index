            </label>
            <select id="route-mode" class="bg-white border border-slate-300 text-slate-800 rounded-lg p-1.5 text-xs focus:ring-2 focus:ring-red-500 font-medium">
              <option value="fastest">Nejrychlejší (preferovat dálnice)</option>
              <option value="shortest">Nejkratší (nejnižší km)</option>
              <option value="regular">Běžná (mimo dálnice)</option>
