      viaSelect.addEventListener('change', (e) => {
        const selectedOpt = viaSelect.options[viaSelect.selectedIndex];
        if (e.target.value) {
          inp.value = e.target.value;
          if (selectedOpt.dataset.lat && selectedOpt.dataset.lon) {
            inp.dataset.lat = selectedOpt.dataset.lat;
            inp.dataset.lon = selectedOpt.dataset.lon;
          } else {
            delete inp.dataset.lat;
            delete inp.dataset.lon;
          }
          sug.classList.add('hidden');
        }
      });

      inp.addEventListener('input', (e) => {
        delete inp.dataset.lat;
        delete inp.dataset.lon;
        const val = e.target.value.trim().toLowerCase();
        if (val.length < 1) { sug.classList.add('hidden'); return; }
        const matches = customCompanies.filter(c => c.name.toLowerCase().includes(val) || c.address.toLowerCase().includes(val)).slice(0, 30);
        if (matches.length > 0) {
          sug.innerHTML = '';
          matches.forEach(m => {
            const item = document.createElement('div');
            item.className = 'p-1.5 hover:bg-red-50 cursor-pointer border-b border-slate-100 text-[11px]';
            item.innerHTML = `<strong>${m.name}</strong> - <span class="text-slate-500">${m.address}</span>`;
            item.addEventListener('click', () => {
              inp.value = m.address;
              if (m.lat && m.lon) {
                inp.dataset.lat = m.lat;
                inp.dataset.lon = m.lon;
              } else {
                delete inp.dataset.lat;
                delete inp.dataset.lon;
              }
              sug.classList.add('hidden');
            });
            sug.appendChild(item);
          });
          sug.classList.remove('hidden');
        } else { sug.classList.add('hidden'); }
      });

      btnSearch.addEventListener('click', async () => {
        const q = inp.value.trim();
        if (!q) return;
        statusMsg.classList.remove('hidden');
        const res = await geocode(q);
        statusMsg.classList.add('hidden');
        if (res) {
          inp.value = res.address;
          if (res.lat && res.lon) {
            inp.dataset.lat = res.lat;
            inp.dataset.lon = res.lon;
          }
        }
      });

      div.querySelector('.btn-remove-via').addEventListener('click', () => div.remove());
    });

    /* INTELIGENTNÍ GEOKODÉR S PŘÍMOU PODPOROU GPS SOUŘADNICE */
    async function geocode(query, explicitLat, explicitLon) {
      if (explicitLat && explicitLon && !isNaN(explicitLat) && !isNaN(explicitLon)) {
        return { name: query, address: query, lat: parseFloat(explicitLat), lon: parseFloat(explicitLon) };
      }

      if (!query) return null;
      const cleanQ = query.trim().toLowerCase();

      const compMatch = customCompanies.find(c => c.address.toLowerCase().includes(cleanQ) || c.name.toLowerCase().includes(cleanQ));
      if (compMatch && compMatch.lat && compMatch.lon) {
        return { name: compMatch.name, address: compMatch.address, lat: parseFloat(compMatch.lat), lon: parseFloat(compMatch.lon) };
      }

      if (MAPY_CZ_API_KEY && MAPY_CZ_API_KEY.trim() !== "") {
        try {
          const mapyUrl = `https://api.mapy.cz/v1/suggest?lang=cs&limit=1&type=regional.address&query=${encodeURIComponent(query)}`;
          const resMapy = await fetch(mapyUrl, {
            headers: { 'X-Mapy-Api-Key': MAPY_CZ_API_KEY.trim() }
          });
          const dataMapy = await resMapy.json();

          if (dataMapy && dataMapy.items && dataMapy.items.length > 0) {
            const item = dataMapy.items[0];
            return {
              name: item.name || query,
              address: `${item.name}, ${item.location}`.trim().replace(/^,\s*/, ''),
              lat: item.position.lat,
              lon: item.position.lon
            };
          }
        } catch (err) {
          console.warn('Mapy.cz API selhalo, přepínám na zálohu:', err);
        }
      }

      try {
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=cz,sk,de,at,pl&limit=1&addressdetails=1`;
        const res = await fetch(url, { headers: { 'Accept-Language': 'cs' } });
        const data = await res.json();

        if (data && data.length > 0) {
          const item = data[0];
          const addr = item.address;
          let label = item.display_name;

          if (addr) {
            const street = addr.road || addr.pedestrian || addr.suburb || '';
            const number = addr.house_number || addr.conscriptionnumber || '';
            const city = addr.city || addr.town || addr.village || '';
            if (street || number || city) {
              label = `${street} ${number}, ${city}`.trim().replace(/^,\s*/, '');
            }
          }

          return {
            name: label || query,
            address: label || query,
            lat: parseFloat(item.lat),
            lon: parseFloat(item.lon)
          };
        }
      } catch (err) {
        console.warn('Záložní geokódování selhalo:', err);
      }

      return null;
    }

    document.getElementById('btn-search-target').addEventListener('click', async () => {
      const q = targetInput.value.trim();
      if (!q) return;
      statusMsg.classList.remove('hidden');
      const res = await geocode(q, targetInput.dataset.lat, targetInput.dataset.lon);
      statusMsg.classList.add('hidden');
      if (res) targetInput.value = res.address;
    });

    function initMap() {
      if (!leafletMap) {
        leafletMap = L.map('map').setView([49.8, 15.5], 7);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(leafletMap);
      }
    }

    function getModeLineStyle(mode) {
      if (mode === 'shortest') return { color: '#059669', weight: 5, opacity: 0.9 };
      if (mode === 'regular') return { color: '#d97706', weight: 5, opacity: 0.9 };
      return { color: '#dc2626', weight: 5, opacity: 0.85 };
    }

    document.getElementById('btn-calculate').addEventListener('click', async () => {
      const techId = techSelect.value;
      const startText = startInput.value.trim();
      const targetText = targetInput.value.trim();

      if (!techId || !startText || !targetText) {
        alert('Vyberte technika a zadejte cílové místo.');
        return;
      }

      statusMsg.classList.remove('hidden');
      resultCard.classList.add('hidden');

      const waypoints = [];
      waypoints.push({
        query: startText,
        lat: startInput.dataset.lat,
        lon: startInput.dataset.lon
      });

      document.querySelectorAll('.via-input').forEach(i => {
        if (i.value.trim()) waypoints.push({ query: i.value.trim(), lat: i.dataset.lat, lon: i.dataset.lon });
      });

      waypoints.push({ query: targetText, lat: targetInput.dataset.lat, lon: targetInput.dataset.lon });

      const coords = [];
      for (const pt of waypoints) {
        const r = await geocode(pt.query, pt.lat, pt.lon);
        if (r && !isNaN(r.lat) && !isNaN(r.lon)) {
          coords.push({ name: pt.query, lat: r.lat, lon: r.lon });
        } else {
          statusMsg.classList.add('hidden');
          alert(`Nenalezeny souřadnice pro místo: "${pt.query}". Zkuste prosím adresu upřesnit.`);
          return;
        }
      }

      const locs = coords.map(c => `${c.lon},${c.lat}`).join(';');
      const mode = routeModeSelect.value;
      const isRound = roundTripCheck.checked;
      
      try {
        const resThere = await fetch(`https://router.project-osrm.org/route/v1/driving/${locs}?overview=full&geometries=geojson`);
        const dataThere = await resThere.json();

        if (dataThere.code !== 'Ok' || !dataThere.routes || !dataThere.routes.length) {
          statusMsg.classList.add('hidden');
          alert('Chyba při výpočtu trasy.');
          return;
        }

        const routeThere = dataThere.routes[0];
        let distThereKm = Math.round(routeThere.distance / 1000);
        let durThereMin = Math.round(routeThere.duration / 60);

        if (mode === 'shortest') { distThereKm = Math.round(distThereKm * 0.94); durThereMin = Math.round(durThereMin * 1.08); }
        else if (mode === 'regular') { distThereKm = Math.round(distThereKm * 0.98); durThereMin = Math.round(durThereMin * 1.15); }

        let totalDistanceKm = distThereKm;
        let totalDurationMin = durThereMin;

        let routeBack = null;
        if (isRound) {
          const startPt = coords[0];
          const endPt = coords[coords.length - 1];
          const locsBack = `${endPt.lon},${endPt.lat};${startPt.lon},${startPt.lat}`;

          try {
            const resBack = await fetch(`https://router.project-osrm.org/route/v1/driving/${locsBack}?overview=full&geometries=geojson`);
            const dataBack = await resBack.json();
            if (dataBack.code === 'Ok' && dataBack.routes && dataBack.routes.length) {
              routeBack = dataBack.routes[0];
              totalDistanceKm += Math.round(routeBack.distance / 1000);
              totalDurationMin += Math.round(routeBack.duration / 60);
            } else {
              totalDistanceKm += distThereKm;
              totalDurationMin += durThereMin;
            }
          } catch (e) {
            totalDistanceKm += distThereKm;
            totalDurationMin += durThereMin;
          }
        }

        statusMsg.classList.add('hidden');

        const hrs = Math.floor(totalDurationMin / 60);
        const mins = totalDurationMin % 60;
        const durationFormatted = hrs > 0 ? `${hrs} h ${mins} min` : `${mins} min`;

        const techObj = technicians.find(t => t.id === techId);
        const modeLabel = routeModeSelect.options[routeModeSelect.selectedIndex].text;

        document.getElementById('res-distance').textContent = `${totalDistanceKm} km`;
        document.getElementById('res-duration').textContent = durationFormatted;
        document.getElementById('res-path-text').textContent = coords.map(c => c.name.split('[')[0].trim()).join(' → ') + (isRound ? ' 🔄 ' + coords[0].name.split('[')[0].trim() : '');
        document.getElementById('res-mode-text').textContent = isRound ? `${modeLabel} (Tam) + Přímá cesta zpět` : modeLabel;

        if (isRound) document.getElementById('res-round-badge').classList.remove('hidden');
        else document.getElementById('res-round-badge').classList.add('hidden');

        let gmapsUrl = `https://www.google.com/maps/dir/?api=1&origin=${coords[0].lat},${coords[0].lon}&destination=${encodeURIComponent(coords[coords.length - 1].name)}`;
        if (coords.length > 2) {
          const viaStr = coords.slice(1, -1).map(c => encodeURIComponent(c.name)).join('|');
          gmapsUrl += `&waypoints=${viaStr}`;
        }
        document.getElementById('btn-google-maps').href = gmapsUrl;

        resultCard.classList.remove('hidden');

        initMap();
        setTimeout(() => {
          leafletMap.invalidateSize();
          if (routePolyline) leafletMap.removeLayer(routePolyline);
          if (returnPolyline) leafletMap.removeLayer(returnPolyline);
          mapMarkers.forEach(m => leafletMap.removeLayer(m));
          mapMarkers = [];

          const lineCoordsThere = routeThere.geometry.coordinates.map(c => [c[1], c[0]]);
          routePolyline = L.polyline(lineCoordsThere, getModeLineStyle(mode)).addTo(leafletMap);

          let boundsGroup = L.featureGroup([routePolyline]);

          if (routeBack) {
            const lineCoordsBack = routeBack.geometry.coordinates.map(c => [c[1], c[0]]);
            returnPolyline = L.polyline(lineCoordsBack, { color: '#9333ea', weight: 4, opacity: 0.7, dashArray: '6, 6' }).addTo(leafletMap);
            boundsGroup.addLayer(returnPolyline);
          }

          coords.forEach((pt, idx) => {
            let color = idx === 0 ? '#16a34a' : (idx === coords.length - 1 ? '#dc2626' : '#d97706');
            const m = L.circleMarker([pt.lat, pt.lon], { radius: 7, fillColor: color, color: '#ffffff', weight: 2, fillOpacity: 0.9 }).addTo(leafletMap).bindPopup(pt.name);
            mapMarkers.push(m);
          });

          leafletMap.fitBounds(boundsGroup.getBounds(), { padding: [25, 25] });
        }, 150);

        currentCalculation = { tech: techObj.name, start: startText, target: targetText, distanceKm: totalDistanceKm, durationFormatted, isRound, modeLabel };

      } catch (err) {
        statusMsg.classList.add('hidden');
        alert('Chyba při komunikaci s navigací.');
      }
    });

    document.getElementById('btn-copy-km').addEventListener('click', (e) => {
      if (!currentCalculation) return;
      navigator.clipboard.writeText(`${currentCalculation.distanceKm} km`);
      const btn = e.currentTarget;
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Zkopírováno!';
      setTimeout(() => btn.innerHTML = orig, 1500);
    });

    document.getElementById('btn-copy-summary').addEventListener('click', (e) => {
      if (!currentCalculation) return;
      const c = currentCalculation;
      const rText = c.isRound ? ' (TAM I ZPĚT)' : '';
      navigator.clipboard.writeText(`${c.tech}: ${c.start} → ${c.target}${rText} [${c.modeLabel}] = ${c.distanceKm} km (${c.durationFormatted})`);
      const btn = e.currentTarget;
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Zkopírováno!';
      setTimeout(() => btn.innerHTML = orig, 1500);
    });

    const modal = document.getElementById('modal-settings');
    const tabBtnTechs = document.getElementById('tab-btn-techs');
    const tabBtnCompanies = document.getElementById('tab-btn-companies');
    const tabTechs = document.getElementById('tab-techs');
    const tabCompanies = document.getElementById('tab-companies');

    document.getElementById('btn-settings').addEventListener('click', () => {
      renderTechManageList();
      renderCompanyManageList();
      modal.classList.remove('hidden');
    });
    document.getElementById('btn-close-modal').addEventListener('click', () => modal.classList.add('hidden'));

    tabBtnTechs.addEventListener('click', () => {
      tabBtnTechs.className = 'text-xs font-bold px-3 py-1.5 rounded-lg bg-red-600 text-white';
      tabBtnCompanies.className = 'text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200';
      tabTechs.classList.remove('hidden');
      tabCompanies.classList.add('hidden');
    });

    tabBtnCompanies.addEventListener('click', () => {
      tabBtnCompanies.className = 'text-xs font-bold px-3 py-1.5 rounded-lg bg-red-600 text-white';
      tabBtnTechs.className = 'text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200';
      tabCompanies.classList.remove('hidden');
      tabTechs.classList.add('hidden');
    });

    function renderTechManageList() {
      const list = document.getElementById('tech-manage-list');
      list.innerHTML = '';
      technicians.forEach((t, idx) => {
        const item = document.createElement('div');
        item.className = 'flex justify-between items-center p-2 bg-slate-50 rounded-lg text-xs border';
        item.innerHTML = `<div><strong>${t.name}</strong><br><span class="text-slate-500">${t.start} (${t.lat}, ${t.lon})</span></div>
                          <button type="button" class="text-red-500 hover:text-red-700 p-1" onclick="deleteTech(${idx})"><i class="fa-solid fa-trash-can"></i></button>`;
        list.appendChild(item);
      });
    }

    function renderCompanyManageList() {
      const list = document.getElementById('company-manage-list');
      list.innerHTML = '';
      customCompanies.forEach((c, idx) => {
        const item = document.createElement('div');
        item.className = 'flex justify-between items-center p-2 bg-slate-50 rounded-lg text-xs border';
        const coordsStr = (c.lat && c.lon) ? ` [GPS: ${c.lat}, ${c.lon}]` : '';
        item.innerHTML = `<div><strong>${c.name}</strong><br><span class="text-slate-500">${c.address}${coordsStr}</span></div>
                          <button type="button" class="text-red-500 hover:text-red-700 p-1" onclick="deleteCompany(${idx})"><i class="fa-solid fa-trash-can"></i></button>`;
        list.appendChild(item);
      });
    }

    window.deleteTech = function(idx) {
      technicians.splice(idx, 1);
      safeSet('tech_db_v40', technicians);
      initTechs();
      renderTechManageList();
    };

    window.deleteCompany = function(idx) {
      customCompanies.splice(idx, 1);
      safeSet('company_db_v40', customCompanies);
      renderQuickTargetDropdown();
      document.querySelectorAll('.via-quick-select').forEach(sel => populateViaDropdown(sel));
      renderCompanyManageList();
    };

    document.getElementById('btn-add-tech').addEventListener('click', () => {
      const name = document.getElementById('new-tech-name').value.trim();
      const start = document.getElementById('new-tech-start').value.trim();
      const lat = parseFloat(document.getElementById('new-tech-lat').value.trim());
      const lon = parseFloat(document.getElementById('new-tech-lon').value.trim());
      if (!name || !start || isNaN(lat) || isNaN(lon)) {
        alert('Vyplňte prosím jméno, název výchozího místa i obě GPS souřadnice (lat/lon).');
        return;
      }
      technicians.push({ id: Date.now().toString(), name, start, lat, lon });
      safeSet('tech_db_v40', technicians);
      initTechs();
      renderTechManageList();
      document.getElementById('new-tech-name').value = '';
      document.getElementById('new-tech-start').value = '';
      document.getElementById('new-tech-lat').value = '';
      document.getElementById('new-tech-lon').value = '';
    });

    document.getElementById('btn-add-company').addEventListener('click', () => {
      const name = document.getElementById('new-company-name').value.trim();
      const address = document.getElementById('new-company-address').value.trim();
      const lat = parseFloat(document.getElementById('new-company-lat').value.trim());
      const lon = parseFloat(document.getElementById('new-company-lon').value.trim());
      if (!name || !address) return;
      const compObj = { name, address };
      if (!isNaN(lat) && !isNaN(lon)) {
        compObj.lat = lat;
        compObj.lon = lon;
      }
      customCompanies.push(compObj);
      safeSet('company_db_v40', customCompanies);
      renderQuickTargetDropdown();
      document.querySelectorAll('.via-quick-select').forEach(sel => populateViaDropdown(sel));
      renderCompanyManageList();
      document.getElementById('new-company-name').value = '';
      document.getElementById('new-company-address').value = '';
      document.getElementById('new-company-lat').value = '';
      document.getElementById('new-company-lon').value = '';
    });

    initTechs();
    renderQuickTargetDropdown();
    initMap();
  </script>
</body>
</html>
