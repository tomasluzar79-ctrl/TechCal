<body class="bg-slate-100 text-slate-800 p-2 sm:p-4">
  <div class="max-w-6xl mx-auto bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    
    <!-- Hlavička -->
    <div class="bg-slate-900 text-white p-3.5 sm:p-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="bg-red-600 p-2.5 rounded-xl shadow-md">
          <i class="fa-solid fa-map-location-dot text-xl text-white"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold leading-tight">Kalkulačka dojezdů techniků</h1>
          <p class="text-xs text-slate-400">Kompletní databáze firem + Mapy.cz REST API</p>
        </div>
      </div>
      <button id="btn-settings" type="button" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-1.5 rounded-xl text-xs flex items-center gap-1.5 border border-slate-700 transition shadow-sm">
        <i class="fa-solid fa-sliders text-red-400"></i> <span class="hidden sm:inline">Správa databáze</span>
      </button>
    </div>

    <!-- Dvousloupcové rozvržení -->
