              <option value="">-- Vyberte technika --</option>
            </select>
            <i class="fa-solid fa-user-gear absolute left-3 top-3 text-slate-400 text-xs"></i>
            <i class="fa-solid fa-chevron-down absolute right-3 top-3 text-slate-400 text-xs pointer-events-none"></i>
          </div>
        </div>

        <!-- Start -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Místo startu (Uzamčeno na GPS)</label>
          <div class="relative">
            <input type="text" id="start-location" readonly placeholder="Vyberte technika výše..." class="w-full bg-slate-100 border border-slate-200 text-slate-700 text-xs sm:text-sm rounded-xl p-2.5 pl-9 font-semibold">
            <i class="fa-solid fa-location-dot absolute left-3 top-3 text-emerald-600 text-xs"></i>
          </div>
        </div>

        <!-- Průjezdní body -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Průjezdní body (Mezizastávky)</label>
          <div id="via-container" class="space-y-2"></div>
          <button id="btn-add-via" type="button" class="mt-1.5 text-xs font-semibold text-red-600 hover:text-red-800 flex items-center gap-1.5 py-0.5">
            <i class="fa-solid fa-circle-plus text-sm"></i> Přidat průjezdní bod
          </button>
        </div>

        <!-- Cílové místo -->
        <div class="relative space-y-1.5">
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Cílové místo / Firma / Adresa</label>
          <div class="relative flex gap-1.5">
            <div class="relative flex-1">
              <input type="text" id="target-location" autocomplete="off" placeholder="Napište firmu nebo přesnou adresu s č.p...." class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs sm:text-sm rounded-xl p-2.5 pl-9 focus:ring-2 focus:ring-red-500 font-medium">
              <i class="fa-solid fa-flag-checkered absolute left-3 top-3 text-red-500 text-xs"></i>
            </div>
            <button id="btn-search-target" type="button" class="bg-red-600 hover:bg-red-700 text-white font-medium px-3.5 rounded-xl text-xs flex items-center gap-1.5 shadow-sm transition">
              <i class="fa-solid fa-magnifying-glass"></i> <span class="hidden sm:inline">Hledat</span>
            </button>
          </div>

          <!-- Našeptávač firem -->
          <div id="target-suggestions" class="hidden absolute left-0 right-0 sm:right-12 mt-1 bg-white border border-slate-300 rounded-xl shadow-2xl max-h-44 overflow-y-auto z-30 custom-scrollbar"></div>

          <!-- Rozevírací seznam Rychlé volby pro Cíl -->
          <div class="relative">
            <select id="quick-target-select" class="w-full bg-slate-100 border border-slate-200 text-slate-700 text-xs rounded-lg p-2 pr-8 focus:ring-2 focus:ring-red-500 appearance-none cursor-pointer font-medium">
              <option value="">-- Rychlá volba z databáze firem --</option>
            </select>
            <i class="fa-solid fa-chevron-down absolute right-3 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
          </div>
        </div>

        <!-- Volba typu trasy -->
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5 space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <label for="route-mode" class="font-bold text-slate-800 flex items-center gap-1.5">
