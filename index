        <button id="btn-calculate" type="button" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold p-3 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-xs sm:text-sm">
          <i class="fa-solid fa-calculator"></i> Spočítat dojezdovou vzdálenost
        </button>

        <div id="status-msg" class="hidden text-center py-1.5 text-xs font-medium text-slate-500 flex items-center justify-center gap-2">
          <i class="fa-solid fa-circle-notch fa-spin text-red-600 text-sm"></i> Počítám trasu...
        </div>

